# Telegram bot and the only administrator chat.
BOT_TOKEN=replace_with_botfather_token
TELEGRAM_CHAT_ID=123456789

# Telegram Ads account managed by this installation.
ADS_API_TOKEN=replace_with_ads_api_token
ADS_ACCOUNT_ID=replace_with_ads_account_id

# PostgreSQL used by Docker Compose.
POSTGRES_DB=tg_ads_bot
POSTGRES_USER=tg_ads_bot
POSTGRES_PASSWORD=replace_with_a_long_random_password

# Optional overrides for local development.
# DB_HOST=localhost
# DB_PORT=5432
# ADS_API_BASE_URL=https://promoteapi.telegram.org
# LOG_LEVEL=INFO
